    "preRequest": ["/user/hm.html?q={{key}}"],
    "webView": true,
    "gatewayPath": "/userverify",
    "ruleSearch": {
      "bookList": "$[*]",
      "name": "$.articlename",
      "author": "$.author",
      "intro": "$.intro",
      "bookUrl": "$.url_list",
      "coverUrl": "$.url_img"
    },
    "ruleBookInfo": {
      "name": "meta[property='og:title']@content || tag.h1@text",
      "author": "meta[property='og:novel:author']@content",
      "intro": "meta[property='og:description']@content##[ 　]*[0-9]+w[0-9]+-[0-9]+[ 　]*$##",
      "coverUrl": "meta[property='og:image']@content",
      "kind": "meta[property='og:novel:category']@content"
    },
    "ruleToc": {
      "chapterList": "dl.1@tag.dd",
      "chapterName": "tag.a@text",
      "chapterUrl": "tag.a@href"
    },
    "ruleContent": {
      "content": "id.chaptercontent@text || id.content@text"
    }
  },
